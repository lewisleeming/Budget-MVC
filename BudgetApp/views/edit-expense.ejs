<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Expense - BudgetApp</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="app-header">
        <div class="header-container">
            <a href="/dashboard" class="brand-link">💰 BudgetApp</a>
            <div class="header-actions">
                <a href="/dashboard" class="btn btn-secondary btn-sm">← Back to Dashboard</a>
            </div>
        </div>
    </header>

    <main class="page-container">
        <div class="form-card">
            <div class="card-header">
                <h2>Edit Expense</h2>
                <p class="text-muted">Modify transaction details</p>
            </div>

            <% if (messages.error && messages.error.length > 0) { %>
                <div class="alert alert-error" role="alert">
                    <% messages.error.forEach(function(error) { %>
                        <p><%= error %></p>
                    <% }) %>
                </div>
            <% } %>

            <form action="/expenses/<%= expense._id %>/edit" method="POST" class="standard-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="amount">Amount (£) <span class="required">*</span></label>
                    <input 
                        type="number" 
                        id="amount" 
                        name="amount" 
                        value="<%= expense.amount %>" 
                        step="0.01" 
                        min="0.01" 
                        max="10000000"
                        required 
                        autofocus
                    >
                </div>

                <div class="form-group">
                    <label for="description">Description <span class="required">*</span></label>
                    <input 
                        type="text" 
                        id="description" 
                        name="description" 
                        value="<%= expense.description %>" 
                        maxlength="200" 
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="category">Category <span class="required">*</span></label>
                    <select id="category" name="category" required onchange="handleCategoryChange(this)">
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat %>" <%= expense.category === cat ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" id="custom-category-group" style="display: none;">
                    <label for="custom-category">Custom Category Name</label>
                    <input type="text" id="custom-category" placeholder="Enter custom category" maxlength="50">
                </div>

                <div class="form-group">
                    <label for="date">Transaction Date <span class="required">*</span></label>
                    <input type="date" id="date" name="date" value="<%= formattedDate %>" required>
                </div>

                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="isRecurring" name="isRecurring" value="true" <%= expense.isRecurring ? 'checked' : '' %> onchange="toggleRecurringOptions(this)">
                        <span>This is a recurring expense</span>
                    </label>
                </div>

                <div class="form-group" id="frequency-group" style="<%= expense.isRecurring ? '' : 'display: none;' %>">
                    <label for="frequency">Billing Frequency</label>
                    <select id="frequency" name="frequency">
                        <option value="monthly" <%= expense.frequency === 'monthly' ? 'selected' : '' %>>Monthly</option>
                        <option value="weekly" <%= expense.frequency === 'weekly' ? 'selected' : '' %>>Weekly</option>
                        <option value="yearly" <%= expense.frequency === 'yearly' ? 'selected' : '' %>>Yearly</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/dashboard" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <script src="/js/app.js"></script>
</body>
</html>
