# Application Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/budgetapp
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/budgetapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/budgetapp

# Session Security
# Generate a strong 32+ character random string in production
SESSION_SECRET=budget_mvc_secure_session_secret_change_me_in_production_12345

# Localization / Currency
CURRENCY_SYMBOL=£
CURRENCY_CODE=GBP
